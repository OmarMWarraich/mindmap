# --- Model provider credentials ---
# Per-provider API keys. Set only the providers you intend to use; a key is
# validated lazily, the first time one of that provider's models is requested
# (see lib/config/env.ts). Leaving a provider unset simply hides its models.
OPENAI_API_KEY=replace-with-real-api-key
ANTHROPIC_API_KEY=replace-with-real-api-key
# DeepSeek is OpenAI-compatible; uncomment once it is added to the model catalog.
# DEEPSEEK_API_KEY=replace-with-real-api-key

# --- Distributed rate limiting (optional) ---
# Inline-completion rate limiting uses an in-memory store by default (per-instance).
# To enforce a global budget across serverless/multiple instances, configure Upstash
# Redis (REST). Set BOTH or NEITHER; the limiter fails open if Redis is unreachable.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=replace-with-real-token

DATABASE_URL=postgresql://user:password@host:port/database?options

NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-real-secret

AUTH_GITHUB_SECRET=replace-with-real-secret
AUTH_GITHUB_ID=replace-with-real-id

AUTH_GOOGLE_ID=replace-with-real-id
AUTH_GOOGLE_SECRET=replace-with-real-secret